                                  Margin="0,7,0,14" Style="{StaticResource ThemeComboBox}"
                                  SelectionChanged="ThemePresetComboBox_SelectionChanged">
                            <ComboBoxItem Content="Неоновая ночь" Tag="neon" />
                            <ComboBoxItem Content="Океан" Tag="ocean" />
                            <ComboBoxItem Content="Фиолетовый космос" Tag="cosmos" />
                            <ComboBoxItem Content="Изумрудный лес" Tag="emerald" />
                            <ComboBoxItem Content="Закат" Tag="sunset" />
                            <ComboBoxItem Content="Розовый графит" Tag="pink-graphite" />
                            <ComboBoxItem Content="Золотой люкс" Tag="gold-luxe" />
                            <ComboBoxItem Content="Ледяной циан" Tag="ice" />
                        </ComboBox>
                        <TextBlock Text="ЦВЕТ КНОПОК" Foreground="#C9CACD" FontSize="11" FontWeight="SemiBold" />
                        <ComboBox x:Name="AccentThemeComboBox" Width="230" Height="32" HorizontalAlignment="Left"
                                  Margin="0,7,0,14" Style="{StaticResource ThemeComboBox}"
                                  SelectionChanged="AccentThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Фирменный красный" Tag="red" />
                            <ComboBoxItem Content="Синий" Tag="blue" />
                            <ComboBoxItem Content="Фиолетовый" Tag="violet" />
                            <ComboBoxItem Content="Зелёный" Tag="green" />
                            <ComboBoxItem Content="Голубой" Tag="sky" />
                            <ComboBoxItem Content="Бирюзовый" Tag="teal" />
                            <ComboBoxItem Content="Оранжевый" Tag="orange" />
                            <ComboBoxItem Content="Розовый" Tag="pink" />
                            <ComboBoxItem Content="Золотой" Tag="gold" />
                            <ComboBoxItem Content="Лаймовый" Tag="lime" />
                        </ComboBox>
                        <TextBlock Text="ЦВЕТ МЕНЮ" Foreground="#C9CACD" FontSize="11" FontWeight="SemiBold" />
                        <ComboBox x:Name="MenuThemeComboBox" Width="230" Height="32" HorizontalAlignment="Left"
                                  Margin="0,7,0,0" Style="{StaticResource ThemeComboBox}"
                                  SelectionChanged="MenuThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Тёмное меню" Tag="dark" />
                            <ComboBoxItem Content="Чёрное меню" Tag="black" />
                            <ComboBoxItem Content="Графитовое меню" Tag="graphite" />
                            <ComboBoxItem Content="Ночное синее меню" Tag="navy" />
                            <ComboBoxItem Content="Бордовое меню" Tag="burgundy" />
                            <ComboBoxItem Content="Лесное меню" Tag="forest" />
                            <ComboBoxItem Content="Фиолетовое меню" Tag="purple" />
                            <ComboBoxItem Content="Бирюзовое меню" Tag="teal" />
                            <ComboBoxItem Content="Коричневое меню" Tag="brown" />
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="AboutPage" Visibility="Collapsed" Margin="4,2,4,0">
                <TextBlock Text="О ПРОГРАММЕ" Foreground="{DynamicResource AccentStrongBrush}" FontSize="13" FontWeight="Bold" />
                <TextBlock Text="NEXUS TAYPER" Foreground="#F2F2F2" FontSize="28" FontWeight="Black" Margin="0,18,0,4" />
                <TextBlock Text="Локальный инструмент посимвольного ввода для Windows." Foreground="#C4C5C9" FontSize="14" TextWrapping="Wrap" />
                <Border Style="{StaticResource PanelBorder}" Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="Открытый исходный код · MIT License" Foreground="#F0F0F1" />
                        <TextBlock Text="Работает локально. Не использует сеть, телеметрию и буфер обмена."
                                   Foreground="#A9ABB0" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock Text="Версия 0.11.0" Foreground="{DynamicResource AccentStrongBrush}" Margin="0,18,0,0" />
                        <TextBlock Text="Разработчик: @MinoryXD" Cursor="Hand" ToolTip="https://t.me/MinoryXD"
                                   MouseLeftButtonDown="AuthorTelegramLink_MouseLeftButtonDown"
                                   Foreground="{DynamicResource AccentStrongBrush}" FontSize="12" Margin="0,16,0,0" />
                        <TextBlock Text="Хотите поддержать проект? @nxs_user"
                                   Foreground="#D0D1D4" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="Хотите предложить идею? Напишите @nxs_user"
                                   Foreground="#A9ABB0" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="2" Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="2,10,10,0">
            <Button x:Name="StartButton" Height="116" Style="{StaticResource RedButton}" Click="StartButton_Click">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="M 0,0 L 0,18 L 15,9 Z" Fill="White" Width="15" Height="18"
                          Stretch="Fill" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Старт" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock Text="F6" FontSize="12" HorizontalAlignment="Center" Foreground="#FFDADD" />
                </StackPanel>
            </Button>
            <Button x:Name="StopButton" Height="100" Margin="0,12,0,0" Style="{StaticResource StopButtonStyle}"
                    Click="StopButton_Click">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="15" Height="15" CornerRadius="2" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            BorderThickness="2" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Стоп" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock Text="F7" FontSize="12" HorizontalAlignment="Center" Opacity="0.72" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Border x:Name="StatusBanner" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" BorderBrush="#A8CE1622" BorderThickness="1"
                CornerRadius="8" Background="#D8101114" Margin="0,0,10,8" Padding="14,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ϟ" Foreground="{DynamicResource AccentStrongBrush}" FontSize="19" Margin="0,0,12,0" />
                <TextBlock x:Name="StatusTextBlock" Text="Чтобы запустить, нажмите F6" Foreground="#D5D6D9" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
