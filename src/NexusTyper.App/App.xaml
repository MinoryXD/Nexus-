<Application x:Class="NexusTyper.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <FontFamily x:Key="AppFont">./Assets/Fonts/#Manrope</FontFamily>
        <FontFamily x:Key="AppIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="AccentBrush" Color="#E52A36" />
        <SolidColorBrush x:Key="AccentStrongBrush" Color="#FF303B" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF6973" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#D30D1B" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2B1116" />
        <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#0C0D0F" />
        <SolidColorBrush x:Key="MenuSurfaceBrush" Color="#151619" />
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#281013" />
        <SolidColorBrush x:Key="MenuBorderBrush" Color="#25272B" />
        <Color x:Key="AccentGlowColor">#D20D1B</Color>
        <Style x:Key="ScrollTrackRepeatButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border x:Name="TrackSegment" Width="4" HorizontalAlignment="Center"
                                    Margin="0,7" Background="{TemplateBinding Background}"
                                    CornerRadius="2" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}"
                                         Value="Horizontal">
                                <Setter TargetName="TrackSegment" Property="Width" Value="Auto" />
                                <Setter TargetName="TrackSegment" Property="Height" Value="4" />
                                <Setter TargetName="TrackSegment" Property="Margin" Value="7,0" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E52A36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border x:Name="EmptyScrollIndicator" Width="4" Margin="0,8"
                                    HorizontalAlignment="Center" Background="#494B51"
                                    CornerRadius="2" Visibility="Collapsed" />
                            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"
                                   Margin="0,8"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="PageBack" Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Background="#E52A36" Style="{StaticResource ScrollTrackRepeatButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" MinHeight="18" MinWidth="18" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform x:Name="ThumbScale" ScaleX="1" ScaleY="1" />
                                                    </Grid.RenderTransform>
                                                    <Ellipse Width="14" Height="14" Fill="#402B1014">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="#FF2733" BlurRadius="8"
                                                                              ShadowDepth="0" Opacity="0.55" />
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Ellipse x:Name="ThumbFace" Width="12" Height="12"
                                                             Fill="#F3F3F4" Stroke="#F04450" StrokeThickness="2" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                                     Storyboard.TargetProperty="ScaleX" To="1.12"
                                                                                     Duration="0:0:0.14" />
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                                     Storyboard.TargetProperty="ScaleY" To="1.12"
                                                                                     Duration="0:0:0.14" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                                     Storyboard.TargetProperty="ScaleX" To="1"
                                                                                     Duration="0:0:0.16" />
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale"
                                                                                     Storyboard.TargetProperty="ScaleY" To="1"
                                                                                     Duration="0:0:0.16" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbFace" Property="Stroke" Value="#FF2733" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="PageForward" Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Background="#494B51" Style="{StaticResource ScrollTrackRepeatButton}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Maximum" Value="0">
                                <Setter TargetName="EmptyScrollIndicator" Property="Visibility" Value="Visible" />
                                <Setter TargetName="PART_Track" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="Height" Value="12" />
                                <Setter TargetName="PART_Track" Property="Margin" Value="8,0" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="PageBack" Property="Command"
                                        Value="{x:Static ScrollBar.PageLeftCommand}" />
                                <Setter TargetName="PageForward" Property="Command"
                                        Value="{x:Static ScrollBar.PageRightCommand}" />
                                <Setter TargetName="EmptyScrollIndicator" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
